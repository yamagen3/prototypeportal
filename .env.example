# Database Configuration
POSTGRES_DB=prototypeportal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Application Configuration
APP_ENV=development
API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_URL=http://localhost:3000

# External System Integration
EXTERNAL_APPROVAL_WEBHOOK_URL=http://external-approval-system/webhook
EXTERNAL_APPROVAL_POLL_INTERVAL=300000

# pgAdmin Configuration (Optional)
PGADMIN_DEFAULT_EMAIL=admin@prototypeportal.com
PGADMIN_DEFAULT_PASSWORD=admin
